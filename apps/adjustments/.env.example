# Microsoft Entra ID (single-tenant app registration). Redirect URI: http://localhost:3002/api/auth/callback/microsoft-entra-id
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_SECRET=

# Auth.js session encryption key: `openssl rand -base64 32`
AUTH_SECRET=
AUTH_TRUST_HOST=true

# External customer database (Postgres). Required unless DEMO_MODE=true. Create/upgrade the schema with `npm run db:migrate -w apps/adjustments`.
DATABASE_URL=postgres://adjustments_app:password@db.internal:5432/core
# require (default for remote hosts) | no-verify | disable (default for localhost)
# DATABASE_SSL=require
# DATABASE_POOL_MAX=10
# DATABASE_STATEMENT_TIMEOUT_MS=10000
DATABASE_APPLICATION_NAME=balance-adjustments

# Mock personas + in-memory database instead of Entra and Postgres. Never enable in production.
# DEMO_MODE=true
