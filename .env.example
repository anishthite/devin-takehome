# Microsoft Entra ID (single-tenant app registration)
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_SECRET=

# Auth.js session encryption key: `openssl rand -base64 32`
AUTH_SECRET=
# Required when not running on Vercel / behind a trusted proxy in production
AUTH_TRUST_HOST=true

# Mock personas instead of Entra (see README "Demo mode"). Never enable in production.
# DEMO_MODE=true
