# Microsoft Entra ID (single-tenant app registration)
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_SECRET=

# Auth.js session encryption key: `openssl rand -base64 32`
AUTH_SECRET=
# Required when not running on Vercel / behind a trusted proxy in production
AUTH_TRUST_HOST=true

# Mock personas instead of Entra (see README "Demo mode"). Never enable in production.
# DEMO_MODE=true

# Dataverse adapters (off by default). With DEMO_MODE=true this uses the in-memory mock org in src/demo/dataverse.
# DATAVERSE_ENABLED=true
# Environment URL; the app authenticates as a Dataverse application user via client credentials.
# DATAVERSE_URL=https://contoso.crm.dynamics.com
# Defaults to ENTRA_TENANT_ID / ENTRA_CLIENT_ID / ENTRA_CLIENT_SECRET when unset.
# DATAVERSE_TENANT_ID=
# DATAVERSE_CLIENT_ID=
# DATAVERSE_CLIENT_SECRET=
# Map Ledger roles to Dataverse security roles: template ids win, names are the fallback.
# DATAVERSE_ROLE_TEMPLATE_IDS=Ledger.Admin=627090ff-40a3-4053-8790-584edc5be201
# DATAVERSE_ROLE_NAMES=Ledger.Viewer=Ledger Viewer,Ledger.Operator=Ledger Operator
# Publisher prefix of the optional approval-status mirror table (<prefix>ledgerapproval). Unset = no mirror.
# DATAVERSE_MIRROR_PREFIX=cr7f3_
